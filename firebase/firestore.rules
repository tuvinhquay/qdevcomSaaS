rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function currentCompanyId() {
      return hasUserProfile() ? userData().companyId : null;
    }

    function currentRole() {
      return hasUserProfile() ? userData().role : null;
    }

    function isCompanyMember(companyId) {
      return hasUserProfile() && currentCompanyId() == companyId;
    }

    function isBootstrapCompanyOwner(companyId) {
      return isSignedIn() &&
        !hasUserProfile() &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    function isOwner() {
      return currentRole() == 'owner';
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    function isManager() {
      return currentRole() == 'manager';
    }

    function isStaff() {
      return currentRole() == 'staff';
    }

    function isGuest() {
      return currentRole() == 'guest';
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function hasRole(companyId, roles) {
      return isCompanyMember(companyId) && currentRole() in roles;
    }

    function moduleEnabled(companyId, moduleFlag) {
      return exists(/databases/$(database)/documents/companies/$(companyId)/modules/core) &&
        get(/databases/$(database)/documents/companies/$(companyId)/modules/core).data[moduleFlag] == true;
    }

    function canReadChats(companyId) {
      return isCompanyMember(companyId) && moduleEnabled(companyId, 'chatEnabled');
    }

    function canWriteChats(companyId) {
      return canReadChats(companyId) && !isGuest();
    }

    function canReadProduction(companyId) {
      return isCompanyMember(companyId) && moduleEnabled(companyId, 'productionEnabled');
    }

    function canWriteProduction(companyId) {
      return canReadProduction(companyId) && (isOwnerOrAdmin() || isManager());
    }

    function canReadWarehouse(companyId) {
      return isCompanyMember(companyId) && moduleEnabled(companyId, 'warehouseEnabled');
    }

    function canWriteWarehouse(companyId) {
      return canReadWarehouse(companyId) && (isOwnerOrAdmin() || isStaff());
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isOwnerOrAdmin() && resource.data.companyId == currentCompanyId())
      );

      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          isOwnerOrAdmin() &&
          resource.data.companyId == currentCompanyId() &&
          request.resource.data.companyId == currentCompanyId()
        )
      );

      allow delete: if false;
    }

    match /companies/{companyId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isCompanyMember(companyId) || isBootstrapCompanyOwner(companyId);
      allow update, delete: if isCompanyMember(companyId) && isOwnerOrAdmin();

      match /members/{memberId} {
        allow read: if isCompanyMember(companyId);
        allow create: if
          (isCompanyMember(companyId) && isOwnerOrAdmin()) ||
          (
            isBootstrapCompanyOwner(companyId) &&
            memberId == request.auth.uid &&
            request.resource.data.role == 'owner'
          );
        allow update, delete: if isCompanyMember(companyId) && isOwnerOrAdmin();
      }

      match /modules/{moduleId} {
        allow read: if isCompanyMember(companyId);
        allow write: if
          (isCompanyMember(companyId) && isOwnerOrAdmin()) ||
          (isBootstrapCompanyOwner(companyId) && moduleId == 'core');
      }

      match /workOrders/{docId} {
        allow read: if isSignedIn() && isCompanyMember(companyId) &&
          currentRole() in ['owner', 'admin', 'manager', 'staff'];
        allow create, update: if isSignedIn() && isCompanyMember(companyId) &&
          currentRole() in ['owner', 'admin', 'manager'];
        allow delete: if isSignedIn() && isCompanyMember(companyId) &&
          currentRole() in ['owner', 'admin'];
      }

      match /productionOrders/{docId} {
        allow read: if isCompanyMember(companyId);
        allow create: if hasRole(companyId, ['owner', 'admin', 'manager']);
        allow update: if hasRole(companyId, ['owner', 'admin', 'manager']);
        allow delete: if hasRole(companyId, ['owner', 'admin']);
      }

      match /warehouse/{itemId} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if hasRole(companyId, ['owner', 'admin', 'manager']);
        allow delete: if hasRole(companyId, ['owner', 'admin']);
      }

      match /chat/{messageId} {
        allow read, create: if isCompanyMember(companyId);
        allow update, delete: if
          hasRole(companyId, ['owner', 'admin', 'manager']) ||
          (request.auth != null && request.auth.uid == resource.data.senderId);
      }

      match /inventory/{docId} {
        allow read: if canReadWarehouse(companyId);
        allow write: if canWriteWarehouse(companyId);
      }

      match /chats/{docId} {
        allow read: if canReadChats(companyId);
        allow write: if canWriteChats(companyId);
      }
    }

    // Prompt 13 - advanced chat model scoped by tenant.
    match /tenants/{tenantId} {
      function isTenantMember() {
        return isCompanyMember(tenantId);
      }

      function isTenantAdmin() {
        return isTenantMember() && currentRole() in ['owner', 'admin'];
      }

      match /friend_requests/{requestId} {
        allow read: if isTenantMember() &&
          (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isTenantAdmin());
        allow create: if isTenantMember() && request.resource.data.senderId == request.auth.uid;
        allow update: if isTenantMember() &&
          (
            resource.data.receiverId == request.auth.uid ||
            resource.data.senderId == request.auth.uid ||
            isTenantAdmin()
          );
        allow delete: if false;
      }

      match /groups/{groupId} {
        allow read: if isTenantMember() && (
          request.auth.uid in resource.data.memberIds ||
          isTenantAdmin()
        );
        allow create: if isTenantMember();
        allow update: if isTenantMember() && (
          request.auth.uid in resource.data.admins ||
          resource.data.createdBy == request.auth.uid ||
          isTenantAdmin()
        );
        allow delete: if isTenantAdmin() || resource.data.createdBy == request.auth.uid;

        match /members/{memberId} {
          allow read: if isTenantMember();
          allow write: if isTenantMember() && (
            isTenantAdmin() ||
            request.auth.uid == memberId ||
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)/groups/$(groupId)).data.admins
          );
        }
      }

      match /chats/{chatId} {
        allow read: if isTenantMember() && (
          request.auth.uid in resource.data.participants ||
          isTenantAdmin()
        );
        allow create: if isTenantMember();
        allow update: if isTenantMember() && (
          request.auth.uid in resource.data.participants ||
          isTenantAdmin()
        );
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isTenantMember() && (
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)/chats/$(chatId)).data.participants ||
            isTenantAdmin()
          );
          allow create: if isTenantMember() && (
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)/chats/$(chatId)).data.participants ||
            request.resource.data.senderId == 'q-assistant'
          );
          allow update, delete: if isTenantMember() && (
            resource.data.senderId == request.auth.uid ||
            isTenantAdmin()
          );
        }
      }
    }
  }
}
